# Environment variables for the Node.js app on Hostinger (all optional).

# MySQL (recommended as the community grows). Without these, the community
# saves everything to a data file in DATA_DIR (default: ~/.gtavi-data).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Folder for chat photos and, when MySQL is not configured, the data file.
# Use a folder outside the app so nothing is lost on deploy.
DATA_DIR=

# Long random string used to sign login cookies (generated and saved automatically if empty).
SESSION_SECRET=

# Comma-separated usernames that moderate the community and the chat
# (delete any post, comment or message, review reports and mute users).
ADMIN_USERS=

# "Entrar con Google" (Google Cloud > Google Auth Platform > Clientes, tipo "Aplicación web").
# Authorized redirect URI: https://gtavivicecity.com/api/auth/google/callback
# The button only appears when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
